generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  password         String
  emailVerified    DateTime?
  image            String?
  googleId         String?   @unique
  resetToken       String?
  resetTokenExpiry DateTime?
  accounts         Account[]
  addresses        Address[]
  cart             Cart?
  otps             OTP[]
  orders           Order[]
  reviews          Review[]
  sessions         Session[]
  wishlist         Wishlist?
  orderFeedback    OrderFeedback[]   // ← ADD THIS
}
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id             String         @id @default(cuid())
  name           String
  price          Int
  originalPrice  Int
  discount       Int
  images         String[]
  color          String
  category       String
  tileType       String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  length         Float?
  breadth        Float?
  height         Float?
  weight         Float?
  description    String?
  features       String[]       @default([])
  productDetails String[]       @default([])
  productdesc    String?
  sizeData       Json?
  cartItems      CartItem[]
  reviews        Review[]
  wishlistItems  WishlistItem[]
}

model AvailableColors {
  id              String @id @default(cuid())
  category        String @unique
  colors          Json
  colorCategories Json
}

model Wishlist {
  id     String         @id @default(cuid())
  userId String         @unique
  user   User           @relation(fields: [userId], references: [id])
  items  WishlistItem[]
}

model WishlistItem {
  id                 String   @id @default(cuid())
  wishlistId         String

  // item types
  productId          String?
  prebuiltProductId  String?

  printerId          String?
  resinId            String?



  resinColourId      String?
  resinWeightId      String?

 

  createdAt          DateTime @default(now())

  wishlist           Wishlist @relation(fields: [wishlistId], references: [id])

  product            Product?         @relation(fields: [productId], references: [id])

  prebuiltProduct PrebuiltProducts? @relation(fields: [prebuiltProductId], references: [id])
  printer            Printer?         @relation(fields: [printerId], references: [id])
  resin              Resin?           @relation(fields: [resinId], references: [id])
}

model AboutHero {
  id             String   @id @default(cuid())
  headline       String
  headlineAccent String?
  subtext        String?
  mediaUrl       String
  buttonText     String?
  buttonLink     String?
  updatedAt      DateTime @updatedAt
}

model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
}

model CartItem {
  id                String            @id @default(cuid())
  cartId            String
  productId         String?
  prebuiltProductId String?
  prebuiltVariantId String?
  productSizeId     String?
  productColorId    String?
  quantity          Int
  printerId         String?
  resinId           String?
  resinColourId     String?
  resinWeightId     String?

  addedAt       DateTime @default(now())
  customization String?

  cart            Cart              @relation(fields: [cartId], references: [id])
  product         Product?          @relation(fields: [productId], references: [id])
  prebuiltProduct PrebuiltProducts? @relation(fields: [prebuiltProductId], references: [id])
  prebuiltVariant PrebuiltVariants? @relation(fields: [prebuiltVariantId], references: [id])
  printer         Printer?          @relation(fields: [printerId], references: [id])
  resin           Resin?            @relation(fields: [resinId], references: [id], onDelete: Cascade)
  resinColour     ResinColour?      @relation(fields: [resinColourId], references: [id])
  resinWeight     ResinWeight?      @relation(fields: [resinWeightId], references: [id])

  @@unique([cartId, productId, prebuiltVariantId, productSizeId, productColorId, printerId, resinId, resinColourId, resinWeightId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  email     String
  phone     String
  street    String
  landmark  String?
  city      String
  state     String
  zipCode   String
  pincode   String?
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model OTP {
  id        String   @id @default(cuid())
  userId    String
  token     String
  action    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  attempts  Int      @default(0)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, action])
}

model Blog {
  id             String   @id @default(cuid())
  slug           String?  @unique @db.VarChar(255)  // SEO-friendly URLs /blog/my-post-title
  title          String   @db.VarChar(255)
  content        String
  description    String?  @db.VarChar(500)
  keywords       String   @db.VarChar(255)
  thumbnailImage String?  @db.VarChar(255)
  heroImage      String?  @db.VarChar(255)
  published      Boolean  @default(false)           // draft vs live control
  publishedAt    DateTime?                           // track when it went live
  featured       Boolean  @default(false)            // pin one to the featured hero slot
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HeroBanner {
  id                 String   @id @default(cuid())
  headline           String
  headlineAccent     String?
  subtext            String?
  mediaUrl           String
  mediaType          String   @default("image")
  altText            String?
  buttonText         String?
  buttonLink         String?
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  duration           Int      @default(5000)

  // NEW: configurable colors
  buttonGradientFrom String?  @default("#4f46e5")
  buttonGradientTo   String?  @default("#7c3aed")
  textColor          String?  @default("#ffffff")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
model CarouselItem {
  id        String   @id @default(cuid())
  type      String
  src       String
  duration  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CommunityImage {
  id        String  @id @default(cuid())

  imageUrl  String              // Cloudinary URL
  altText   String?
  linkPath  String?             // Optional — e.g. "/printers/xyz" or "/prebuilt-products/abc"

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CustomerTestimonial {
  id        String  @id @default(cuid())

  quote     String
  name      String              // "Marcus K."
  role      String              // "Lead Engineer, Nexa Aero"
  initials  String              // "MK"
  rating    Int     @default(5) // 1-5 stars

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model BestSeller {
  id          String   @id @default(cuid())

  // Common fields (hero + small cards)
  name        String
  price       String              // stored as string e.g. "2323" — ₹ added by frontend
  image       String              // Cloudinary URL
  href        String              // e.g. "/printers/xyz"
  isHero      Boolean  @default(false)

  // Small card only
  variant     String?             // e.g. "SHADOW BLACK"

  // Hero card only
  description String?             // shown below name on hero
  specs       Json?               // [{ "label": "PRINT SPEED", "value": "500mm/s" }]

  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model Partner {
  id        String   @id @default(cuid())
  name      String   // The Heading (e.g., Acme Corp)
  sub       String   // The Subheading (e.g., Aerospace)
  image     String   // The Image URL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormResponse {
  id                  String   @id @default(cuid())
  service             String
  requirement         String
  fileExtension       String
  prototype           String
  prototypeOption     String?
  printingTechnology  String
  material            String?
  materialType        String?
  materialDescription String?
  quantity            Int?
  productColor        String
  filamentColor       String?
  resinColor          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SmallBatchRequest {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String
  address   String
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relation to individual products
  products  SmallBatchProduct[]
}

model SmallBatchProduct {
  id              String   @id @default(cuid())
  designFile      String
  quantity        Int
  notes           String?
  technology      String
  material        String
  materialSubtype String?
  colorMode       String
  colors          String[] // Stored as string array
  
  // Relation back to parent request
  requestId       String
  request         SmallBatchRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}
model PrototypingRequest {
  id                  String   @id @default(cuid())


  projectType         String   // Functional Prototype | Low-Volume Production
  technology          String   // FDM | SLA/DLP | SLS
  material            String
  materialSubtype     String?


  colors              String[] // Multi-select supported


  designFiles         String[] // Cloudinary URLs


  quantityType        String?  // Single | Small Batch | Large Batch
  quantityNumber      Int? @default(1)


  specialRequirements String?


  fullName            String?
  email               String
  phone               String
  company             String?
  address             String?



  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
model Onetimep {
  id        String   @id @default(cuid())
  email     String
  otp       String
  createdAt DateTime @default(now())
  expiresAt DateTime
  attempts  Int      @default(0)

  @@index([email])
}

model PersonaliseFormResponse {
  id            String   @id @default(cuid())
  isAware       String
  categories    String[]
  statueDetails String
  wantMore      String
  name          String?
  email         String?
  phone         String?
  userId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Form3DResponse {
  id                  String    @id @default(cuid())

  // Files (Cloudinary URLs)
  fileReference       String?
  additionalFile      String?

  // Project details
  requirement         String
  fileExtension       String

  // Manufacturing / production
  productionType      String?            // "prototype" | "small_batch" | "design_only"
  quantity            Int?              // null for design_only, 1 for prototype, user value for small_batch

  // Technology, material & colour (null when productionType = "design_only")
  printingTechnology  String?           // "FDM" | "SLA/DLP" | "SLS"
  materialFamily      String?           // e.g. "PLA", "ABS", "Standard Resin", "Nylon"
  material            String?           // sub-type, e.g. "PLA+", "PLA Matte", "TPU 95A" (null for SLA/DLP & SLS)
  color               String?           // final colour selection

  // Customer details
  firstName           String
  lastName            String
  email               String
  phone               String
  address             String?
  company             String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}


model Review {
  id                String           @id @default(cuid())
  rating            Int
  title             String
  content           String
  userId            String
  productId         String?
  prebuiltProductId String?
 
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  prebuiltProduct PrebuiltProducts? @relation(fields: [prebuiltProductId], references: [id])
  product           Product?         @relation(fields: [productId], references: [id])
  user              User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([prebuiltProductId])
}

model Announcement {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                String    @id @default(cuid())
  userId            String

  items             Json
  subtotal          Float?
  discountAmount    Float?    @default(0)
  discountCode      String?
  tax               Float?    @default(0)
  shippingPrice     Float?    @default(0)
  totalAmount       Float

  status            String    @default("payment_pending")

  shippingAddress   Json
  billingAddress    Json

  paymentMethod     String?
  paymentReference  String?
  maskedPaymentId   String?
  utrNumber         String?
  brnNumber         String?
  cardNetwork       String?

  transactionId     String?   @unique
  trackingInfo      Json?

  refundStatus      String?
  refundId          String?
  refundInitiatedAt DateTime?
  refundCompletedAt DateTime?

  shippingMode      String?
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id])
  shipments         Shipment[]
  feedback          OrderFeedback?

  invoice           Invoice?

  @@index([userId])
}
model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  orderId       String   @unique

  issuedAt      DateTime @default(now())
  subtotal      Float
  tax           Float
  total         Float

  status        String   @default("issued")
  // issued | adjusted | cancelled

  order         Order    @relation(fields: [orderId], references: [id])
  creditNotes   CreditNote[]

  @@index([issuedAt])
}
model CreditNote {
  id               String   @id @default(cuid())
  creditNoteNumber String   @unique
  invoiceId        String

  amount           Float
  reason           String
  issuedAt         DateTime @default(now())

  invoice          Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([issuedAt])
}

model DocumentCounter {
  id        Int      @id @default(autoincrement())
  key       String   @unique   // "invoice" | "credit_note"
  lastNo    Int
  updatedAt DateTime @updatedAt
}

model OrderFeedback {
  id        String   @id @default(cuid())
  orderId   String   @unique
  userId    String
  items     Json                      // [{ index, name, productId, itemType }]
  tags      String[]                  // ["Product quality", "Delivery experience"]
  comment   String?                   // Optional, max 500 chars
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order    @relation(fields: [orderId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}
model Discount {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique

  scope         DiscountScope
  valueType     DiscountValueType
  value         Float

  minOrderValue Float?
  maxDiscount   Float?

  expiresAt     DateTime?
  isHidden      Boolean  @default(false)
  isActive      Boolean  @default(true)

  itemTypes     DiscountItemType[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DiscountItemType {
  id         String   @id @default(cuid())
  discountId String
  itemType   ItemType

  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@unique([discountId, itemType])
}

enum DiscountScope {
  cart
  item_type
}

enum DiscountValueType {
  percentage
  flat
}

enum ItemType {
  product
  prebuilt
  printer
  resin
}

model Shipment {
  id               String    @id @default(cuid())
  orderId          String    // No @unique for MPS support
  provider         String    @default("DELHIVERY_TEST")
  waybill          String?   @unique
  status           String
  trackingUrl      String?
  rawResponse      Json?
  labelGenerated   Boolean   @default(false)
  labelGeneratedAt DateTime?

  lastError      String?
  attempts       Int       @default(0)
  lastSyncedAt   DateTime?
  syncing        Boolean   @default(false)

  // MPS FIELDS
  shipmentType   String    @default("SPS")
  isMaster       Boolean   @default(true)
  masterWaybill  String?
  childWaybills  String[]  @default([])
  packageCount   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([masterWaybill])
}


model PickupRequest {
  id                  String   @id @default(cuid())
  pickupLocation       String
  pickupDate           DateTime
  pickupTime           String
  expectedPackageCount Int
  pickupId             Int
  status               String   @default("scheduled")
  createdAt            DateTime @default(now())

  @@unique([pickupLocation, pickupDate])
}


model PincodeLocation {
  pincode   String  @id
  latitude  Float
  longitude Float
  city      String?
  state     String?
}

model HeroImage {
  id        String   @id @default(uuid())
  page      String
  imageUrl  String
  alt       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Printer {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  brand String
  inStock Boolean @default(true)

  // Pricing
  price         Int // Current price in paise
  originalPrice Int? // Original price (for discount calculation)
  discount      Int? // Discount percentage

  // Basic Info
  technology       String
  experience       String
  description      String?
  shortDescription String? // For card view

  // Build Volume
  volumeLength Int
  volumeWidth  Int
  volumeHeight Int
  volumeMax    Int
  weight     Int?

  // Images
  images PrinterImage[]

  // Related Data
  attributes     PrinterAttribute[]
  specifications PrinterSpecification[]
  features       PrinterFeature[]
  applications   PrinterApplication[]
  downloads      PrinterDownload[]


  // SEO & Metadata
  metaTitle        String?
  metaDescription  String?
  wishlistItems    WishlistItem[]
  // Warranty & Support
  warrantyYears    Int            @default(1)
  freeInstallation Boolean        @default(true)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cartItems CartItem[]

  @@index([technology])
  @@index([brand])
  @@index([volumeMax])
  @@index([price])
}


model PrinterImage {
  id        String  @id @default(cuid())
  printerId String
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isMain    Boolean @default(false)

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([printerId, sortOrder])
}


model PrinterAttribute {
  id             String @id @default(cuid())
  printerId      String
  attributeKey   String
  attributeValue String

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([printerId])
  @@index([attributeKey, attributeValue])
}


model PrinterSpecification {
  id        String @id @default(cuid())
  printerId String
  category  String // "Build Specifications", "Print Specifications", etc.
  label     String // "Build Volume", "Nozzle Diameter", etc.
  value     String // "300 × 300 × 300 mm", "0.4 mm", etc.
  sortOrder Int    @default(0)

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([printerId, category, sortOrder])
}


model PrinterFeature {
  id          String  @id @default(cuid())
  printerId   String
  title       String
  description String?
  sortOrder   Int     @default(0)

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([printerId, sortOrder])
}


model PrinterApplication {
  id        String @id @default(cuid())
  printerId String
  name      String // "Rapid Prototyping", "Functional Parts", etc.
  sortOrder Int    @default(0)

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([printerId, sortOrder])
}


model PrinterDownload {
  id          String  @id @default(cuid())
  printerId   String
  title       String // "Product Datasheet", "User Manual", etc.
  description String? // Optional description
  downloadUrl String? // Direct link to PDF (external URL or internal path)
  sortOrder   Int     @default(0)

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([printerId, sortOrder])
}


model SupportContent {
  id        String @id @default(cuid())
  printerId String
  section   String // "Warranty Information", "After-Sales Support", etc.
  content   String @db.Text
  sortOrder Int    @default(0)

  @@index([printerId, sortOrder])
}

model Resin {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  brand String
  inStock          Boolean @default(true) 

  technology String
  resolution String[]

  shortDescription String?
  description      String?
  cardImageUrl       String?
  images ResinImage[]

  colours        ResinColour[]
  weights        ResinWeight[]
  attributes     ResinAttribute[]
  specifications ResinSpecification[]
  features       ResinFeature[]
  downloads      ResinDownload[]
  applications ResinApplication[]
  compatibilities ResinCompatibility[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ResinColour {
  id      String @id @default(cuid())
  resinId String

  name      String // "Grey", "Clear", "Black"
  hexCode   String?
  sortOrder Int     @default(0)
  inStock   Boolean @default(true) 

  images ResinImage[]

  resin    Resin      @relation(fields: [resinId], references: [id], onDelete: Cascade)
  CartItem CartItem[]

  @@index([resinId])
}

model ResinImage {
  id       String @id @default(cuid())
  colourId String

  url       String
  altText   String?
  sortOrder Int     @default(0)
  isMain    Boolean @default(false)

  colour  ResinColour @relation(fields: [colourId], references: [id], onDelete: Cascade)
  Resin   Resin?      @relation(fields: [resinId], references: [id])
  resinId String?

  @@index([colourId, sortOrder])
}

model ResinWeight {
  id      String @id @default(cuid())
  resinId String

  weightInGrams Int // 500, 1000, 2000
  price         Int // ₹ (integer)
  originalPrice Int? // ₹ (integer)
  discount      Int? // ₹ (integer)
  inStock       Boolean @default(true) 

  sortOrder     Int @default(0)

  resin    Resin      @relation(fields: [resinId], references: [id], onDelete: Cascade)
  CartItem CartItem[]

  @@index([resinId])
}
model ResinAttribute {
  id      String @id @default(cuid())
  resinId String

  label String // "Viscosity"
  value String // "Low"

  resin Resin @relation(fields: [resinId], references: [id], onDelete: Cascade)

  @@index([label, value])
}
model ResinSpecification {
  id      String @id @default(cuid())
  resinId String

  category  String
  label     String
  value     String
  sortOrder Int    @default(0)

  resin Resin @relation(fields: [resinId], references: [id], onDelete: Cascade)

  @@index([resinId, category, sortOrder])
}
model ResinFeature {
  id      String @id @default(cuid())
  resinId String

  title       String
  description String?
  sortOrder   Int     @default(0)

  resin Resin @relation(fields: [resinId], references: [id], onDelete: Cascade)
}
model ResinDownload {
  id      String @id @default(cuid())
  resinId String

  title       String
  description String?
  downloadUrl String?
  sortOrder   Int     @default(0)

  resin Resin @relation(fields: [resinId], references: [id], onDelete: Cascade)
}
model ResinApplication {
  id        String @id @default(cuid())
 resinId String
  name      String // "Rapid Prototyping", "Functional Parts", etc.
  sortOrder Int    @default(0)

 resin Resin @relation(fields: [resinId], references: [id], onDelete: Cascade)

  @@index([resinId, sortOrder])
}
model ResinCompatibility {
  id        String @id @default(cuid())
 resinId String
  name      String // "Rapid Prototyping", "Functional Parts", etc.
  sortOrder Int    @default(0)

 resin Resin @relation(fields: [resinId], references: [id], onDelete: Cascade)

  @@index([resinId, sortOrder])
}
model PrebuiltProducts {
  id               String  @id @default(cuid())
  name             String
  slug             String? @unique
  shortDescription String?
  longDescription  String?
  category         String
  isCustomizable   Boolean @default(false)
  highlighted      Boolean @default(false)
  inStock          Boolean @default(true)
  weight  Float?
  features String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  images        PrebuiltImages[]
  attributes    PrebuiltAttributes[]
  variants      PrebuiltVariants[]
  cartItems     CartItem[]
  reviews       Review[]
  wishlistItems WishlistItem[]

}
model PrebuiltImages {
    id                String               @id @default(cuid())
    prebuildProductId String
    url               String
    altText           String?
    position          Int                  @default(0)
    colorName         String?
    isMain            Boolean              @default(false)   // ← ADD THIS
    createdAt         DateTime             @default(now())
    updatedAt         DateTime?             @updatedAt
    product           PrebuiltProducts  @relation(fields: [prebuildProductId], references: [id], onDelete: Cascade)
}
model PrebuiltAttributes {
  id    String @id @default(cuid())
  label String // "Material"
  value String // "Aluminium"

  prebuildProductId String
  prebuiltProduct   PrebuiltProducts @relation(fields: [prebuildProductId], references: [id], onDelete: Cascade)

  @@unique([prebuildProductId, label])
}
model PrebuiltVariants {
  id            String  @id @default(cuid())
  price         Int // 
  originalPrice Int     @default(0)

  isActive      Boolean @default(true)
  inStock       Boolean  @default(true)

  colorName String? // "Midnight Black"
  colorHex  String? // "#1a1a1a"

  sizeName String? 
  length  Float?
  breadth Float?
  height Float?
 

  prebuildProductId String
  prebuiltProduct   PrebuiltProducts @relation(fields: [prebuildProductId], references: [id], onDelete: Cascade)

  cartItems CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([prebuildProductId, colorName, sizeName])
}
model StockNotification {
  id           String    @id @default(cuid())
  productId    String
  productName  String
  productType  String    @default("prebuilt") // "prebuilt" | "printer" | "resin"
  variantId    String?   // null = whole product OOS; set = specific variant OOS
  variantLabel String?   // e.g. "Red, Large" — stored at save time for admin display
  email        String
  phone        String
  name         String?
  notified     Boolean   @default(false)
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())
}