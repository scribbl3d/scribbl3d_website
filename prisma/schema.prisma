generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  password         String
  emailVerified    DateTime?
  image            String?
  googleId         String?   @unique
  resetToken       String?
  resetTokenExpiry DateTime?
  accounts         Account[]
  addresses        Address[]
  cart             Cart?
  otps             OTP[]
  orders           Order[]
  reviews          Review[]
  sessions         Session[]
  wishlist         Wishlist?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id             String         @id @default(cuid())
  name           String
  price          Int
  originalPrice  Int
  discount       Int
  images         String[]
  color          String
  category       String
  tileType       String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  length         Float?
  breadth        Float?
  height         Float?
  weight         Float?
  description    String?
  features       String[]       @default([])
  productDetails String[]       @default([])
  productdesc    String?
  sizeData       Json?
  cartItems      CartItem[]
  reviews        Review[]
  wishlistItems  WishlistItem[]
}

model AvailableColors {
  id              String @id @default(cuid())
  category        String @unique
  colors          Json
  colorCategories Json
}

model PrebuiltProduct {
  id              String         @id @default(cuid())
  name            String
  description     String
  images          String[]
  price           Int            @default(0)
  originalPrice   Int            @default(0)
  availableColors String[]       @default([])
  availableSizes  String[]       @default([])
  isCustomizable  Boolean        @default(false)
  category        String
  highlighted     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  length          Float?
  breadth         Float?
  height          Float?
  weight          Float?
  features        String[]       @default([])
  productDetails  String[]       @default([])
  productdesc     String?
  sizeData        Json?
  cartItems       CartItem[]
  colors          ProductColor[]
  sizes           ProductSize[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
}

model ProductSize {
  id                String          @id @default(cuid())
  name              String
  price             Int
  originalPrice     Int
  sizeType          String          @default("standard")
  prebuiltProductId String
  cartItems         CartItem[]
  prebuiltProduct   PrebuiltProduct @relation(fields: [prebuiltProductId], references: [id], onDelete: Cascade)

  @@unique([prebuiltProductId, name])
  @@index([prebuiltProductId])
}

model ProductColor {
  id                String          @id @default(cuid())
  name              String
  hexCode           String
  prebuiltProductId String
  cartItems         CartItem[]
  prebuiltProduct   PrebuiltProduct @relation(fields: [prebuiltProductId], references: [id], onDelete: Cascade)

  @@unique([prebuiltProductId, name])
  @@index([prebuiltProductId])
}

model Wishlist {
  id     String         @id @default(cuid())
  userId String         @unique
  user   User           @relation(fields: [userId], references: [id])
  items  WishlistItem[]
}

model WishlistItem {
  id                 String   @id @default(cuid())
  wishlistId         String

  // item types
  productId          String?
  prebuiltProductId  String?
  printerId          String?
  resinId            String?

  // variants (optional)
  productSizeId      String?
  productColorId     String?

  resinColourId      String?
  resinWeightId      String?

  prebuiltColor      String?
  prebuiltSize       String?

  createdAt          DateTime @default(now())

  wishlist           Wishlist @relation(fields: [wishlistId], references: [id])

  product            Product?         @relation(fields: [productId], references: [id])
  prebuiltProduct    PrebuiltProduct? @relation(fields: [prebuiltProductId], references: [id])
  printer            Printer?         @relation(fields: [printerId], references: [id])
  resin              Resin?           @relation(fields: [resinId], references: [id])
}



model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
}

model CartItem {
  id                String       @id @default(cuid())
  cartId            String
  productId         String?
  prebuiltProductId String?
  productSizeId     String?
  productColorId    String?
  quantity          Int
  printerId         String?
  printer           Printer?     @relation(fields: [printerId], references: [id])
   /* 🧱 PREBUILT (NEW) */
  prebuiltColour    String?
  prebuiltSize      String?
  // Resin selection
  resinId           String?
  resin             Resin?       @relation(fields: [resinId], references: [id], onDelete: Cascade)
  resinColourId     String?
  resinColour       ResinColour? @relation(fields: [resinColourId], references: [id])
  resinWeightId     String?
  resinWeight       ResinWeight? @relation(fields: [resinWeightId], references: [id])

  addedAt         DateTime         @default(now())
  customization   String?
  cart            Cart             @relation(fields: [cartId], references: [id])
  prebuiltProduct PrebuiltProduct? @relation(fields: [prebuiltProductId], references: [id])

  productColor ProductColor? @relation(fields: [productColorId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])
  productSize  ProductSize?  @relation(fields: [productSizeId], references: [id])

  @@unique([cartId, productId, prebuiltProductId, productSizeId, productColorId, printerId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  email     String
  phone     String
  street    String
  landmark  String?
  city      String
  state     String
  zipCode   String
  pincode   String?
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model OTP {
  id        String   @id @default(cuid())
  userId    String
  token     String
  action    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  attempts  Int      @default(0)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, action])
}

model Blog {
  id             String   @id @default(cuid())
  title          String   @db.VarChar(255)
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  keywords       String   @db.VarChar(255)
  description    String?  @db.VarChar(500)
  thumbnailImage String?  @db.VarChar(255)
  heroImage      String?  @db.VarChar(255)
}

model CarouselItem {
  id        String   @id @default(cuid())
  type      String
  src       String
  duration  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormResponse {
  id                  String   @id @default(cuid())
  service             String
  requirement         String
  fileExtension       String
  prototype           String
  prototypeOption     String?
  printingTechnology  String
  material            String?
  materialType        String?
  materialDescription String?
  quantity            Int?
  productColor        String
  filamentColor       String?
  resinColor          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SmallBatchManufacturingResponse {
  id              String   @id @default(cuid())
  designFile      String?
  quantity        Int
  requirements    String?
  technology      String
  material        String
  materialSubtype String?
  productColor    String
  filamentColor   String?
  resinColor      String?
  firstName       String
  lastName        String
  email           String
  phone           String
  company         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PrototypingRequest {
  id                  String   @id @default(cuid())
  projectType         String
  technology          String
  material            String
  materialSubtype     String?
  color               String
  filamentColor       String?
  resinColor          String?
  customMaterial      String?
  designFile          String?
  specialRequirements String?
  bulkQuantity        String?
  firstName           String
  lastName            String
  email               String
  phone               String
  company             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Onetimep {
  id        String   @id @default(cuid())
  email     String
  otp       String
  createdAt DateTime @default(now())
  expiresAt DateTime
  attempts  Int      @default(0)

  @@index([email])
}

model PersonaliseFormResponse {
  id            String   @id @default(cuid())
  isAware       String
  categories    String[]
  statueDetails String
  wantMore      String
  name          String?
  email         String?
  phone         String?
  userId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Form3DResponse {
  id                  String   @id @default(cuid())
  service             String
  fileReference       String?
  requirement         String
  fileExtension       String
  prototype           String
  prototypeOption     String?
  printingTechnology  String?
  material            String?
  materialType        String?
  materialDescription String?
  quantity            Int?
  productColor        String?
  filamentColor       String?
  resinColor          String?
  additionalFile      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Review {
  id                String           @id @default(cuid())
  rating            Int
  title             String
  content           String
  userId            String
  productId         String?
  prebuiltProductId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  prebuiltProduct   PrebuiltProduct? @relation(fields: [prebuiltProductId], references: [id])
  product           Product?         @relation(fields: [productId], references: [id])
  user              User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([prebuiltProductId])
}

model Announcement {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                String    @id @default(cuid())
  userId            String
  items             Json
  totalAmount       Float
  status            String    @default("payment_pending")

  shippingAddress   Json
  billingAddress    Json

  paymentMethod       String?       // UPI | CREDIT_CARD | DEBIT_CARD | NET_BANKING | WALLET (from PhonePe)
  paymentReference  String?       // PhonePe ref / RRN
  maskedPaymentId   String?       // masked UPI or card

  transactionId     String?   @unique
  trackingInfo      Json?

  // Refund
  refundStatus           String?  // initiated | success | failed
  refundId               String?
  refundInitiatedAt      DateTime?  @default(now())
  refundCompletedAt      DateTime?   @default(now())
  createdAt         DateTime  @default(now())
 shippingMode      String?
  user              User      @relation(fields: [userId], references: [id])
  shipment          Shipment?


  @@index([userId])
}



model Shipment {
  id               String    @id @default(cuid())
  orderId          String    @unique
  provider         String    @default("DEHIVERY_TEST")
  waybill          String? // make optional if not available yet
  status           String
  trackingUrl      String?
  rawResponse      Json?
  labelGenerated   Boolean   @default(false)
  labelGeneratedAt DateTime?

  lastError String?
  attempts  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id])
}
model PickupRequest {
  id                  String   @id @default(cuid())
  pickupLocation       String
  pickupDate           DateTime
  pickupTime           String
  expectedPackageCount Int
  pickupId             Int
  status               String   @default("scheduled")
  createdAt            DateTime @default(now())

  @@unique([pickupLocation, pickupDate])
}


model PincodeLocation {
  pincode   String  @id
  latitude  Float
  longitude Float
  city      String?
  state     String?
}

model HeroImage {
  id        String   @id @default(uuid())
  page      String
  imageUrl  String
  alt       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Printer {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  brand String

  // Pricing
  price         Int // Current price in paise
  originalPrice Int? // Original price (for discount calculation)
  discount      Int? // Discount percentage

  // Basic Info
  technology       String
  experience       String
  description      String?
  shortDescription String? // For card view

  // Build Volume
  volumeLength Int
  volumeWidth  Int
  volumeHeight Int
  volumeMax    Int

  // Images
  images PrinterImage[]

  // Related Data
  attributes     PrinterAttribute[]
  specifications PrinterSpecification[]
  features       PrinterFeature[]
  applications   PrinterApplication[]
  downloads      PrinterDownload[]

  // SEO & Metadata
  metaTitle        String?
  metaDescription  String?
  wishlistItems    WishlistItem[]
  // Warranty & Support
  warrantyYears    Int            @default(1)
  freeInstallation Boolean        @default(true)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cartItems CartItem[]

  @@index([technology])
  @@index([brand])
  @@index([volumeMax])
  @@index([price])
}


model PrinterImage {
  id        String  @id @default(cuid())
  printerId String
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isMain    Boolean @default(false)

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([printerId, sortOrder])
}


model PrinterAttribute {
  id             String @id @default(cuid())
  printerId      String
  attributeKey   String
  attributeValue String

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([printerId])
  @@index([attributeKey, attributeValue])
}


model PrinterSpecification {
  id        String @id @default(cuid())
  printerId String
  category  String // "Build Specifications", "Print Specifications", etc.
  label     String // "Build Volume", "Nozzle Diameter", etc.
  value     String // "300 × 300 × 300 mm", "0.4 mm", etc.
  sortOrder Int    @default(0)

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([printerId, category, sortOrder])
}


model PrinterFeature {
  id          String  @id @default(cuid())
  printerId   String
  title       String
  description String?
  sortOrder   Int     @default(0)

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([printerId, sortOrder])
}


model PrinterApplication {
  id        String @id @default(cuid())
  printerId String
  name      String // "Rapid Prototyping", "Functional Parts", etc.
  sortOrder Int    @default(0)

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([printerId, sortOrder])
}


model PrinterDownload {
  id          String  @id @default(cuid())
  printerId   String
  title       String // "Product Datasheet", "User Manual", etc.
  description String? // Optional description
  downloadUrl String? // Direct link to PDF (external URL or internal path)
  sortOrder   Int     @default(0)

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([printerId, sortOrder])
}


model SupportContent {
  id        String @id @default(cuid())
  printerId String
  section   String // "Warranty Information", "After-Sales Support", etc.
  content   String @db.Text
  sortOrder Int    @default(0)

  @@index([printerId, sortOrder])
}

model Resin {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  brand String

  technology String
  resolution String[]

  shortDescription String?
  description      String?
  cardImageUrl       String?
  images ResinImage[]

  colours        ResinColour[]
  weights        ResinWeight[]
  attributes     ResinAttribute[]
  specifications ResinSpecification[]
  features       ResinFeature[]
  downloads      ResinDownload[]
  applications ResinApplication[]
  compatibilities ResinCompatibility[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ResinColour {
  id      String @id @default(cuid())
  resinId String

  name      String // "Grey", "Clear", "Black"
  hexCode   String?
  sortOrder Int     @default(0)

  images ResinImage[]

  resin    Resin      @relation(fields: [resinId], references: [id], onDelete: Cascade)
  CartItem CartItem[]

  @@index([resinId])
}

model ResinImage {
  id       String @id @default(cuid())
  colourId String

  url       String
  altText   String?
  sortOrder Int     @default(0)
  isMain    Boolean @default(false)

  colour  ResinColour @relation(fields: [colourId], references: [id], onDelete: Cascade)
  Resin   Resin?      @relation(fields: [resinId], references: [id])
  resinId String?

  @@index([colourId, sortOrder])
}

model ResinWeight {
  id      String @id @default(cuid())
  resinId String

  weightInGrams Int // 500, 1000, 2000
  price         Int // ₹ (integer)
  originalPrice Int? // ₹ (integer)
  discount      Int? // ₹ (integer)

  sortOrder     Int @default(0)

  resin    Resin      @relation(fields: [resinId], references: [id], onDelete: Cascade)
  CartItem CartItem[]

  @@index([resinId])
}


model ResinAttribute {
  id      String @id @default(cuid())
  resinId String

  label String // "Viscosity"
  value String // "Low"

  resin Resin @relation(fields: [resinId], references: [id], onDelete: Cascade)

  @@index([label, value])
}

model ResinSpecification {
  id      String @id @default(cuid())
  resinId String

  category  String
  label     String
  value     String
  sortOrder Int    @default(0)

  resin Resin @relation(fields: [resinId], references: [id], onDelete: Cascade)

  @@index([resinId, category, sortOrder])
}

model ResinFeature {
  id      String @id @default(cuid())
  resinId String

  title       String
  description String?
  sortOrder   Int     @default(0)

  resin Resin @relation(fields: [resinId], references: [id], onDelete: Cascade)
}

model ResinDownload {
  id      String @id @default(cuid())
  resinId String

  title       String
  description String?
  downloadUrl String?
  sortOrder   Int     @default(0)

  resin Resin @relation(fields: [resinId], references: [id], onDelete: Cascade)
}
model ResinApplication {
  id        String @id @default(cuid())
 resinId String
  name      String // "Rapid Prototyping", "Functional Parts", etc.
  sortOrder Int    @default(0)

 resin Resin @relation(fields: [resinId], references: [id], onDelete: Cascade)

  @@index([resinId, sortOrder])
}

model ResinCompatibility {
  id        String @id @default(cuid())
 resinId String
  name      String // "Rapid Prototyping", "Functional Parts", etc.
  sortOrder Int    @default(0)

 resin Resin @relation(fields: [resinId], references: [id], onDelete: Cascade)

  @@index([resinId, sortOrder])
}

