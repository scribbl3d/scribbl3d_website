# Database
DATABASE_URL="postgresql://user:password@localhost:5432/scribbl3d"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Optional dedicated secrets (32+ random characters, e.g. `openssl rand -hex 32`)
# for admin sessions and /api/internal calls. When unset, separate keys are
# derived from NEXTAUTH_SECRET.
ADMIN_SESSION_SECRET=""
INTERNAL_API_SECRET=""

# Client IP for rate limits. Reverse proxies in front of the app that append
# to X-Forwarded-For (default 1). Or set CLIENT_IP_HEADER to a header your
# proxy always overwrites (e.g. x-real-ip).
TRUSTED_PROXY_HOPS="1"
CLIENT_IP_HEADER=""

# Base URL for SEO (Production URL)
NEXT_PUBLIC_BASE_URL="https://scribbl3d.com"

# OAuth Providers (if applicable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payment Gateway
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# PhonePe refunds (v3 credit API). Required outside production so local and
# preview cancellations never send real refunds; production defaults to the
# PhonePe production refund host when unset.
PHONEPE_REFUND_URL=""

# Email Service
# Add your email service credentials here

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Delhivery Shipping
DELHIVERY_API_KEY=""

# Redis (if using)
REDIS_URL=""

# Google Search Console Verification
GOOGLE_VERIFICATION_CODE=""
